# Copy to .env.local at the repo root. Every app loads this one file; there is
# no per-app env file. Never commit .env.local.

# ---- Database (Aiven PostgreSQL) ----
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL_MODE=require
DATABASE_URL=

# ---- Object storage (Cloudflare R2) ----
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_TOKEN=
R2_PUBLIC_URL=

# ---- Authentication (Clerk) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Where Clerk sends people. The welcome screen collects the username after sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/welcome

# ---- Site ----
# The public origin: https://mediary.com in production, http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Catalog providers (filled in when the adapters are built) ----
TMDB_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# TMDB (movies and TV catalog): themoviedb.org -> Settings -> API
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
