{
  "name": "mediary-monorepo",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter client dev",
    "dev:client": "pnpm --filter client dev",
    "dev:admin": "pnpm --filter admin dev",
    "build": "pnpm test && pnpm -r --workspace-concurrency=1 build",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "test": "vitest run --passWithNoTests",
    "test:db:setup": "dotenv -e .env.local -- tsx scripts/setup-test-db.ts",
    "test:integration": "dotenv -e .env.local -- vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --project=desktop --project=phone",
    "test:visual": "pnpm --filter client build && dotenv -v VISUAL=1 -- playwright test --project=visual-desktop --project=visual-phone",
    "test:visual:update": "pnpm --filter client build && dotenv -v VISUAL=1 -- playwright test --project=visual-desktop --project=visual-phone --update-snapshots",
    "db:push": "dotenv -e .env.local -- tsx scripts/ensure-extensions.ts && dotenv -e .env.local -- drizzle-kit push",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "catalog:seed": "dotenv -e .env.local -- tsx scripts/seed-catalog.ts",
    "catalog:refresh": "dotenv -e .env.local -- tsx scripts/refresh-catalog.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/pg": "^8.15.5",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3"
  }
}
